# --- Génération Gemini ---
# Sans clé, l'assistant fonctionne en mode documentaire
# (réponses construites uniquement à partir des documents).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Base de données ---
# Par défaut : SQLite dans backend/data/narsa.db
# DATABASE_URL=sqlite:///./backend/data/narsa.db

# --- Espace administration ---
ADMIN_USERNAME=agent
ADMIN_PASSWORD=narsa2026
ADMIN_DISPLAY_NAME=Agent NARSA
ADMIN_SECRET=changez-cette-valeur-en-production
ADMIN_TOKEN_TTL_MINUTES=480

# --- Interface et API ---
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=*
# Sert l'interface web depuis FastAPI (http://127.0.0.1:8000)
SERVE_FRONTEND=true
# Journalise les échanges pour alimenter le Dashboard IA
LOG_CONVERSATIONS=true
# Précharge les modèles au démarrage (première question plus rapide)
PRELOAD_MODELS=true

# --- Repli et quotas Gemini ---
# Chaque modèle a son propre quota : en cas de 429, l'assistant
# bascule automatiquement sur le suivant.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Durée (secondes) pendant laquelle un modèle épuisé est ignoré
GEMINI_QUOTA_COOLDOWN_SECONDS=900

# --- Cache des réponses ---
ANSWER_CACHE_ENABLED=true

# --- Notifications email ---
EMAIL_ENABLED=true
# Sans SMTP_HOST, les emails sont affichés dans la console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=abdoyu993@gmail.com
SMTP_PASSWORD=fvkcmremjtsqrwnd
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
EMAIL_SENDER=abdoyu993@gmail.com
# URL publique du portail, utilisée dans les emails
PORTAL_URL=http://127.0.0.1:8000
